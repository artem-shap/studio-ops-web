# Base URL of studio-ops-api. Server-side only.
STUDIO_API_URL=http://localhost:8000

# Shared secret sent to studio-ops-api as the X-Studio-Key header.
# It must match STUDIO_API_KEY in that application. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# Server-side only. Never prefix either of these with NEXT_PUBLIC_:
# the browser does not talk to the API and has no use for its key.
STUDIO_API_KEY=
